{
    "name": "fof/pwa",
    "description": "Turn your flarum site into a progressive web app!",
    "type": "flarum-extension",
    "license": "MIT",
    "keywords": [
        "flarum",
        "pwa",
        "web push"
    ],
    "support": {
        "issues": "https://github.com/FriendsOfFlarum/pwa/issues",
        "source": "https://github.com/FriendsOfFlarum/pwa",
        "forum": "https://discuss.flarum.org/d/39678-friendsofflarum-progressive-web-app"
    },
    "funding": [
        {
            "type": "website",
            "url": "https://opencollective.com/fof/donate"
        }
    ],
    "homepage": "https://friendsofflarum.org",
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache"
    },
    "scripts-descriptions": {
        "analyse:phpstan": "Run static analysis"
    },
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0.0-rc.8",
        "minishlink/web-push": "^11.0.0",
        "spomky-labs/base64url": "^2.0.4",
        "kreait/firebase-php": "^8.4.0"
    },
    "require-dev": {
        "flarum/phpstan": "^2.0.0-rc.5",
        "flarum/gdpr": "^2.0@RC"
    },
    "minimum-stability": "RC",
    "suggest": {
        "ext-gmp": "This can improve push notification performance."
    },
    "authors": [
        {
            "name": "FriendsOfFlarum",
            "homepage": "https://friendsofflarum.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "FoF\\PWA\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FoF PWA",
            "category": "feature",
            "icon": {
                "name": "fas fa-mobile-alt",
                "backgroundColor": "#e74c3c",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": false,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": false,
                "bundlewatch": false,
                "backendTesting": false,
                "editorConfig": true,
                "styleci": true
            }
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "replace": {
        "askvortsov/flarum-pwa": "*"
    }
}
